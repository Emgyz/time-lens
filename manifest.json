{
  "manifest_version": 3,
  "name": "TimeLens",
  "version": "3.0.0",
  "description": "Track time spent on websites, decrease social media usage, set limits, and use Focus Mode.",
  "permissions": [
    "storage",
    "tabs",
    "idle",
    "alarms",
    "notifications",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "code/background.js"
  },
  "action": {
    "default_title": "TimeLens",
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png"
    }
  },
  "options_page": "pages/options.html",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}